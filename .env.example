PORT=5002
VITE_PORT=3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
# Optional overrides. The defaults use Judge0 CE for sandboxed compile/run and Google STUN for voice.
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_AUTH_TOKEN=
# Use PISTON_URL only for a self-hosted Piston instance (the public API may reject requests).
# PISTON_URL=http://localhost:2000/api/v2/execute
# TURN relay improves voice connectivity across restrictive networks. Use credentials from your TURN provider.
# ICE_TURN_URL=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# ICE_TURN_USERNAME=
# ICE_TURN_CREDENTIAL=
# CORS_ORIGIN=https://your-domain.example
